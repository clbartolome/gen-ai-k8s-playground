# Copy to config.secret.env, fill in your values, then:
#   oc create secret generic gen-ai-playground-config \
#     --from-env-file=config.secret.env \
#     -n gen-ai-playground
#
# Do not commit config.secret.env.

# LLM (required)
LLM_URL=https://your-llm.example.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key
LLM_MODEL=your-model
LLM_TIMEOUT=120
LLM_MAX_TOKENS=1024

# MCP servers — remove lines for MCPs you don't use
OPENSHIFT_MCP_URL=https://openshift-mcp.example.com/mcp/
AAP_MCP_URL=https://aap-mcp.example.com
AAP_MCP_TOKEN=your-aap-token
ITSM_MCP_URL=https://itsm-app.example.com/mcp/
ITSM_MCP_TOKEN=your-itsm-token
TOOLS_TIMEOUT=30

# Shared / agent
SSL_VERIFY=false
LOG_LEVEL=INFO
TRACE_DB_PATH=/tmp/agent-traces.db

# Chat & monitor (in-cluster agent service)
AGENT_URL=http://agent:8080
AGENT_TIMEOUT=120
